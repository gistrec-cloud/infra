#!/bin/sh
# Prints one secret from the "Agent Access" vault using the read-only service
# account token kept in the Keychain (created by scripts/setup-agent-access.sh).
# Used by omp MCP configs: "!/Users/gistrec/Projects/infra/scripts/agent-secret 'op://Agent Access/<item>/<field>'".
case "$1" in
	"op://Agent Access/"*) ;;
	*) echo "agent-secret: only op://Agent Access/ references are allowed" >&2; exit 2 ;;
esac
OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -s op-agent-access -w)" || exit 1
export OP_SERVICE_ACCOUNT_TOKEN
exec op read -n "$1"
