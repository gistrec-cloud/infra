# {{ ansible_managed }}
[mysqld]
innodb_buffer_pool_size = {{ mysql_innodb_buffer_pool_size }}
max_connections         = {{ mysql_max_connections }}

# Match the managed cluster (terraform/yandex/mysql.tf) so behaviour is identical
# — same strict sql_mode, same utf8mb4 defaults, same time zone (else SYSTEM
# inherits the host's UTC).
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
default-time-zone    = '{{ mysql_time_zone }}'
{% if mysql_max_execution_time | int > 0 %}

# ─── Runaway-query guard (see mysql_max_execution_time in defaults) ───
# Deliberately init_connect and NOT `max_execution_time = N` as a global: the
# server runs that per-connection string only for clients WITHOUT SUPER /
# CONNECTION_ADMIN. That exemption is the whole point — backup.sh dumps as root,
# and mysqldump's table scans are plain SELECTs that a global setting would
# happily kill mid-dump (mysqldump has no --init-command to opt out, and a dump
# killed mid-stream is exactly what the .partial dance exists to avoid).
# So: apps and ad-hoc analytics users are capped, root's backups and migrations
# are not. Caps SELECT only — DML/DDL and long migrations are unaffected.
init_connect = 'SET SESSION max_execution_time = {{ mysql_max_execution_time }}'
{% endif %}
{% if mysql_tls_enabled %}

# TLS: present the LE cert so clients verifying the server cert connect by name.
ssl-cert = /etc/mysql/tls/fullchain.pem
ssl-key  = /etc/mysql/tls/privkey.pem
{% endif %}
{% if mysql_role in ['primary', 'replica'] %}

# ─── Replication (GTID) ───
server_id                  = {{ mysql_server_id }}
gtid_mode                  = ON
enforce_gtid_consistency   = ON
log_bin                    = mysql-bin
binlog_format              = ROW
# log_replica_updates lets a promoted replica act as a source for others and
# keeps its own binlog consistent — required for clean failover/failback.
log_replica_updates        = ON
binlog_expire_logs_seconds = {{ mysql_binlog_expire_seconds }}
{% endif %}
{% if mysql_role == 'replica' %}
relay_log                  = relay-bin
# read_only/super_read_only deliberately NOT here: in the cnf they apply to the
# entrypoint's temp server too, so a fresh init can't even create root (caught
# on russia-03, 2026-08-19), and the seed load needs a writable server anyway.
# replica.yml SET PERSISTs them once replication is configured.
{% endif %}
