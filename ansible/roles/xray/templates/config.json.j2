// {{ ansible_managed }}
{#
  Конфиг собирается словарём и сериализуется целиком: ручная JSON-разметка в
  шаблоне ломается на первой же запятой при пустом списке.
#}
{% set inbounds = [] %}
{% if xray_reality_enabled %}
{%   set clients = [] %}
{%   for client in xray_clients %}
{%     set _ = clients.append({"id": client.uuid, "email": client.name, "flow": "xtls-rprx-vision"}) %}
{%   endfor %}
{%   set _ = inbounds.append({
       "tag": "vless-reality",
       "listen": xray_listen,
       "port": xray_port,
       "protocol": "vless",
       "settings": {"clients": clients, "decryption": "none"},
       "streamSettings": {
         "network": "tcp",
         "security": "reality",
         "realitySettings": {
           "dest": xray_reality_dest,
           "serverNames": xray_reality_server_names,
           "privateKey": xray_reality_private_key,
           "shortIds": xray_reality_short_ids
         }
       },
       "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"]}
     }) %}
{% endif %}
{% if xray_relay_enabled %}
{#
  БЕЗ sniffing: он подменил бы адрес назначения на имя из SNI, и реле
  перестало бы попадать в свою цель. Переливаем байты, ничего не разбирая.
#}
{%   set _ = inbounds.append({
       "tag": "relay",
       "listen": xray_listen,
       "port": xray_relay_port,
       "protocol": "dokodemo-door",
       "settings": {
         "address": xray_relay_target_address,
         "port": xray_relay_target_port,
         "network": "tcp"
       }
     }) %}
{% endif %}
{% set rules = [] %}
{% if xray_relay_enabled %}
{#
  Первым правилом: цель реле лежит в меше, то есть внутри 10.0.0.0/8, который
  ниже уходит в blackhole. Без этой строки реле не работало бы вообще.
#}
{%   set _ = rules.append({"type": "field", "inboundTag": ["relay"], "outboundTag": "direct"}) %}
{% endif %}
{% set _ = rules.append({"type": "field", "ip": xray_blocked_cidrs, "outboundTag": "block"}) %}
{% if xray_block_smtp %}
{%   set _ = rules.append({"type": "field", "port": "25", "outboundTag": "block"}) %}
{% endif %}
{% set config = {
  "log": {"loglevel": xray_loglevel, "access": xray_access_log},
  "inbounds": inbounds,
  "outbounds": [
    {"tag": "direct", "protocol": "freedom", "settings": {"domainStrategy": xray_freedom_strategy}},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": rules
  }
} %}
{{ config | to_nice_json(indent=2) }}
