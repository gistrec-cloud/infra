# {{ ansible_managed }}
[Unit]
Description=Xray VLESS inbound
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ xray_user }}
Group={{ xray_user }}
ExecStart={{ xray_bin }} run -config {{ xray_config_dir }}/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
{% if xray_port < 1024 %}
# Привилегированный порт под системным юзером берётся только так.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
{% else %}
CapabilityBoundingSet=
{% endif %}
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_UNIX нужен резолверу (nsswitch ходит в сокет systemd-resolved).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
