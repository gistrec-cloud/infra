# {{ ansible_managed }}
# Fleet liveness endpoint: GET /health answers 200 on every web host, by the
# host's vps name or by raw IP — nginx matches a literal IP in server_name
# against the Host header that bare-IP probes (curl, uptime monitors, netdata
# httpcheck over wg0) send. Deliberately NOT default_server: gistrec-cloud.conf
# owns that slot on whichever host it lives.
server {
    listen 80;
    listen [::]:80;
    server_name {{ inventory_hostname }}.vps.gistrec.cloud {{ ansible_host }}{% if wireguard_ip is defined %} {{ wireguard_ip }}{% endif %};

    include snippets/honeypot.conf;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

{% if (netdata_alert_feed_dir | default('')) | length > 0 and nginx_alert_feed_allow | length > 0 %}
    # Данные для команд бота алертов (status-snapshot → alert-feed.json). Порт
    # 80 открыт всем, а server_name ловит и подставленный Host, поэтому доступ
    # решает адрес источника: только wg-IP хоста бота, остальным 403.
    location = /alert-feed.json {
{% for addr in nginx_alert_feed_allow %}
        allow {{ addr }};
{% endfor %}
        deny all;
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        alias {{ netdata_alert_feed_dir }}/alert-feed.json;
    }

{% endif %}
    # Anything else addressed here is scanner noise — drop it like the honeypot.
    location / {
        return 444;
    }
}
