# {{ ansible_managed }}
# k3s читает это при старте; менять через роль, не руками.
node-ip: {{ k3s_node_ip }}
node-external-ip: {{ k3s_node_ip }}
advertise-address: {{ k3s_node_ip }}
{# to_json, а не голая подстановка: YAML 1.1 превратил бы SAN `no` в false, а
   строку с двоеточием — в отображение. #}
tls-san:
{% for san in ([k3s_node_ip] + k3s_tls_san_extra) | unique %}
  - {{ san | to_json }}
{% endfor %}

https-listen-port: {{ k3s_api_port }}
cluster-cidr: {{ k3s_cluster_cidr }}
service-cidr: {{ k3s_service_cidr }}

disable:
{% for c in k3s_disable %}
  - {{ c }}
{% endfor %}

{# kubelet НЕ привязываем к адресу: k3s гоняет apiserver→kubelet через свой
   туннель, а тот дозванивается на 127.0.0.1:10250 со стороны агента. С
   address= kubelet уходит с петли, и ломаются logs, exec, port-forward
   (502 Bad Gateway). Порт и так закрыт дефолтным deny в ufw — allow-правил
   для 10250 роль не заводит. #}
{% if not k3s_fail_swap_on %}
kubelet-arg:
  - fail-swap-on=false
{% endif %}
