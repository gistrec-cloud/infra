# {{ ansible_managed }}
# alarm-notify.sh sources the stock health_alarm_notify.conf first and this
# override second, so only the deltas live here. The file is read on every
# notification; changes apply without restarting netdata.

# Telegram — fleet-wide default recipient: every alarm role falls back here.
# The |critical modifier (alarm-notify's filter_recipient_by_criticality) drops
# WARNING notifications: they were ~2/3 of the traffic and none were actionable
# (2026-08-08 — 192 transitions in the log, 95 of them one swap threshold and one
# pending-reboot flag re-raised daily by netdata restarts). CRITICAL still pages,
# and its follow-up de-escalation + CLEAR ride the same tracking file, so a real
# outage still arrives as a "down"/"recovered" pair. Every app health alarm in
# files/netdata/health.d is crit-only, so this costs no application coverage.
SEND_TELEGRAM="YES"
TELEGRAM_BOT_TOKEN="{{ netdata_telegram_bot_token }}"
DEFAULT_RECIPIENT_TELEGRAM="{{ netdata_telegram_chat_id }}|critical"

# `disk` is the one role exempt from that filter — its WARNING must arrive,
# because a filling disk is only actionable *before* it is full. The stock
# disk_space_usage warns at 80% but is `to: sysadmin`, so its WARNING lands in
# the filtered default and the fleet hears nothing until CRITICAL — which the
# stock alarm gates behind `$avail < 5` GB (~93% of finland-01's 75 GB root).
# On 2026-08-13 that meant the first message arrived at 100%, with MySQL already
# refusing writes. Only files/disk_space_early.conf addresses this role, so the
# exemption costs exactly one warning per filling disk, not a reopened floodgate.
role_recipients_telegram[disk]="{{ netdata_telegram_chat_id }}"
{% if netdata_pushover_token | length > 0 %}

# Pushover — the "wake me" escalation layer. Deliberately NOT a default
# recipient: only alarms addressed (`to:`) to a role in netdata_pushover_roles
# page the phone. The stock alarm-notify maps CRITICAL → priority 1 (bypasses
# quiet hours), CLEAR → -1 (silent).
SEND_PUSHOVER="YES"
PUSHOVER_APP_TOKEN="{{ netdata_pushover_token }}"
DEFAULT_RECIPIENT_PUSHOVER="disabled"
{% for role, keys in netdata_pushover_roles.items() %}
role_recipients_pushover[{{ role }}]="{{ keys }}"
{% endfor %}
{% endif %}
