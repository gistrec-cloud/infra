# {{ ansible_managed }}
# go.d prometheus collector jobs. Defined in netdata_prometheus_jobs
# (host_vars); manual edits here are overwritten on the next ansible run.
# Netdata auto-charts every scraped series under prometheus.<job>.<metric> —
# health.d alarms bind to those contexts.
jobs:
{% for job in netdata_prometheus_jobs %}
  - name: {{ job.name }}
    url: {{ job.url }}
{% endfor %}
