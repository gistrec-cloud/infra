# {{ ansible_managed }}
# go.d mysql collector jobs. Defined in netdata_mysql_jobs; the DSN carries
# the monitoring user's password, hence 0640 root:netdata.
jobs:
{% for job in netdata_mysql_jobs %}
  - name: {{ job.name }}
    dsn: '{{ job.dsn }}'
    # DB user is created later in the play (db roles run after netdata)
    autodetection_retry: 60
{% endfor %}
