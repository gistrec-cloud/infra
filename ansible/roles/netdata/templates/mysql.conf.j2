# {{ ansible_managed }}
# go.d mysql collector jobs. Defined in netdata_mysql_jobs (host_vars); manual
# edits here are overwritten on the next ansible run. The DSN carries the
# monitoring user's password — the file ships 0640 root:netdata.
jobs:
{% for job in netdata_mysql_jobs %}
  - name: {{ job.name }}
    dsn: {{ job.dsn }}
{% endfor %}
