# {{ ansible_managed }}
# go.d ping collector jobs. Defined in netdata_ping_jobs (host_vars); manual
# edits here are overwritten on the next ansible run.
jobs:
{% for job in netdata_ping_jobs %}
  - name: {{ job.name }}
    hosts:
      - {{ job.host }}
    update_every: {{ job.update_every | default(5) }}
{% endfor %}
