# {{ ansible_managed }}
# go.d portcheck collector jobs. Defined in netdata_portcheck_jobs (host_vars);
# manual edits here are overwritten on the next ansible run.
jobs:
{% for job in netdata_portcheck_jobs %}
  - name: {{ job.name }}
    host: {{ job.host }}
    ports: [{{ job.ports | join(', ') }}]
    timeout: {{ job.timeout | default(2) }}
    update_every: {{ job.update_every | default(10) }}
{% endfor %}
