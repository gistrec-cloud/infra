# {{ ansible_managed }}
# 0600 root-only; читает s3-rclone (remote'ы yc: gc: gcb:), rclone.conf на диске нет.
# Yandex: SA s3-mirror (storage.viewer)
YC_ACCESS_KEY={{ s3mirror_yc_key_id }}
YC_SECRET_KEY={{ s3mirror_yc_secret }}
# Gcore storage «gistrec» (бакеты приложений)
GC_ACCESS_KEY={{ s3mirror_gc_key_id }}
GC_SECRET_KEY={{ s3mirror_gc_secret }}
# Gcore storage «gistrec-backups» (gistrec-cloud)
GCB_ACCESS_KEY={{ s3mirror_gcb_key_id }}
GCB_SECRET_KEY={{ s3mirror_gcb_secret }}
